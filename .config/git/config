[core]
	editor = vim
    pager = delta
[delta]
    line-numbers = true
    side-by-side = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	process = git-lfs filter-process
	required = true
	smudge = git-lfs smudge -- %f
[init]
	defaultBranch = master
[pull]
	rebase = false
[alias]
	ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"
	ls = ls-files --exclude-standard
